# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=
PORT=3000
CLAUDE_MODEL=claude-opus-4-8

# Account deletion (POST /api/account). The service role key bypasses row level
# security, so it lives only here — never in the app or an EXPO_PUBLIC_ var.
# Both are on the Supabase dashboard under Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
